[project]
name = "az-wind-energy-dp"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
requires-python = "==3.12.*"
dependencies = [
    "azure-identity>=1.20.0,<1.21",
    "azure-storage-blob>=12.28.0,<12.29",
    "pandas>=2.2.3,<2.3",
    "python-dotenv>=1.2.4",
    "requests>=2.32.3,<2.33",
]

[dependency-groups]
dev = [
    "ruff>=0.17.2",
    "databricks-connect~=18.0.0",
]

[tool.databricks.environment]
environment_version = "5"
