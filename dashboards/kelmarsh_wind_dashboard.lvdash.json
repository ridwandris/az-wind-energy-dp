{
  "datasets": [
    {
      "name": "9fd1b8fd",
      "displayName": "daily_performance",
      "queryLines": [
        "SELECT\n",
        "    turbine_id,\n",
        "    turbine_name,\n",
        "    event_date,\n",
        "    event_year,\n",
        "    event_month,\n",
        "    avg_wind_speed_ms,\n",
        "    peak_wind_speed_ms,\n",
        "    avg_active_power_kw,\n",
        "    actual_energy_kwh / 1000.0 AS actual_energy_mwh,\n",
        "    potential_energy_kwh / 1000.0 AS potential_energy_mwh,\n",
        "    lost_downtime_kwh / 1000.0 AS lost_downtime_mwh,\n",
        "    lost_curtailment_kwh / 1000.0 AS lost_curtailment_mwh,\n",
        "    capacity_factor_pct,\n",
        "    power_performance_index_pct,\n",
        "    data_availability_pct\n",
        "FROM kelmarsh_wind.gold.daily_turbine_performance\n",
        "ORDER BY event_date, turbine_id;"
      ]
    },
    {
      "name": "4999865e",
      "displayName": "iec_power_curves",
      "queryLines": [
        "SELECT\n",
        "    turbine_id,\n",
        "    turbine_name,\n",
        "    event_year,\n",
        "    wind_speed_bin_ms,\n",
        "    interval_count,\n",
        "    avg_active_power_kw,\n",
        "    avg_potential_power_kw,\n",
        "    power_deficit_kw,\n",
        "    rated_power_kw\n",
        "FROM kelmarsh_wind.gold.iec_power_curves\n",
        "WHERE wind_speed_bin_ms BETWEEN 0.0 AND 25.0\n",
        "  AND interval_count >= 10\n",
        "ORDER BY wind_speed_bin_ms;"
      ]
    },
    {
      "name": "db715012",
      "displayName": "fault_summary",
      "queryLines": [
        "SELECT\n",
        "    turbine_id,\n",
        "    turbine_name,\n",
        "    event_year,\n",
        "    event_month,\n",
        "    status_type,\n",
        "    COALESCE(iec_category, 'Uncategorized') AS iec_category,\n",
        "    event_count,\n",
        "    total_duration_hours,\n",
        "    mttr_hours\n",
        "FROM kelmarsh_wind.gold.monthly_fault_summary;"
      ]
    }
  ],
